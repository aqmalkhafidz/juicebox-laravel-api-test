{
    "info": {
        "name": "Juicebox API",
        "description": "Laravel 13 API code test. Run register or login to save the Bearer token, then create a post to save its ID. Default login uses the seeded demo account. Registration generates a unique test email. Weather needs WEATHER_API_KEY configured on the server.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        {
            "key": "email",
            "value": "demo@example.com",
            "type": "string"
        },
        {
            "key": "password",
            "value": "password123",
            "type": "string"
        },
        {
            "key": "registration_email",
            "value": "",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        },
        {
            "key": "user_id",
            "value": "1",
            "type": "string"
        },
        {
            "key": "post_id",
            "value": "1",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/register",
                        "description": "Creates a new user, returns a token, and queues a welcome email. A prerequest script generates a unique registration email.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Postman User\",\n    \"email\": \"{{registration_email}}\",\n    \"password\": \"{{password}}\",\n    \"password_confirmation\": \"{{password}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set('registration_email', 'postman.' + Date.now() + '@example.com');"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                                    "if ([200, 201].includes(pm.response.code)) {",
                                    "    const data = pm.response.json().data;",
                                    "    pm.collectionVariables.set('token', data.token);",
                                    "    pm.collectionVariables.set('user_id', String(data.user.id));",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/login",
                        "description": "Defaults to demo@example.com / password123. Stores token and user_id.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                                    "if ([200, 201].includes(pm.response.code)) {",
                                    "    const data = pm.response.json().data;",
                                    "    pm.collectionVariables.set('token', data.token);",
                                    "    pm.collectionVariables.set('user_id', String(data.user.id));",
                                    "}"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Users",
            "item": [
                {
                    "name": "List users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/users?per_page=15&page=1",
                        "description": "Paginated profiles. Other users' emails are hidden."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get user",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/users/{{user_id}}",
                        "description": "Shows email only to its owner."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Posts",
            "item": [
                {
                    "name": "Create post",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/posts",
                        "description": "Creates a post for the token's user and stores post_id.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"A day in Perth\",\n    \"content\": \"Clear skies today.\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 201', () => pm.response.to.have.status(201));",
                                    "if (pm.response.code === 201) {",
                                    "    pm.collectionVariables.set('post_id', String(pm.response.json().data.id));",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "List posts",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/posts?per_page=15&page=1",
                        "description": "Posts ordered by newest ID with authors and pagination."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get post",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/posts/{{post_id}}",
                        "description": "Returns a specific post."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Update post",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/posts/{{post_id}}",
                        "description": "Partially updates a post. Only its owner can do this.",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Updated title\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Delete post",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "url": "{{base_url}}/posts/{{post_id}}",
                        "description": "Deletes a post. Only its owner can do this."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Expected status 204', () => pm.response.to.have.status(204));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Current Perth weather",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/weather",
                "description": "Requires WEATHER_API_KEY on the server. Returns cached current weather or 503 if the provider is unavailable."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Expected status 200', () => pm.response.to.have.status(200));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Logout",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": "{{base_url}}/logout",
                "description": "Revokes the current token and clears it from collection variables."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Expected status 204', () => pm.response.to.have.status(204));",
                            "if (pm.response.code === 204) {",
                            "    pm.collectionVariables.set('token', '');",
                            "}"
                        ]
                    }
                }
            ]
        }
    ]
}
